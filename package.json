{
  "name": "cainiao-pickup-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先的快递取件码统一管理 App（Expo + Drizzle + expo-sqlite）",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/native": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.4",
    "expo-keep-awake": "~14.0.3",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "~18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
